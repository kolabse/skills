{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kolabse/skills/discover-skill-candidates/observation-input.schema.json",
  "title": "Confirmed contextual observations for skill discovery",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "observations"],
  "properties": {
    "schema_version": {"const": 1},
    "observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_type", "source_ref", "summary", "recurrence_count", "user_confirmed"],
        "properties": {
          "source_type": {"enum": ["current-chat", "chat-export", "sync-project-context", "project-practice"]},
          "source_ref": {"type": "string", "minLength": 1, "maxLength": 128},
          "summary": {"type": "string", "minLength": 1, "maxLength": 4000},
          "recurrence_count": {"type": "integer", "minimum": 1, "maximum": 1000},
          "user_confirmed": {"const": true}
        }
      }
    }
  }
}
