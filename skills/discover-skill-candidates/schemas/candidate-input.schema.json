{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kolabse/skills/discover-skill-candidates/candidate-input.schema.json",
  "title": "Skill candidate scoring input",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidates"],
  "properties": {
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "title",
          "summary",
          "source_block_ids",
          "triggers",
          "workflow_steps",
          "completion_criteria",
          "safety_boundaries",
          "resources",
          "scope",
          "stability",
          "automation",
          "disqualifiers",
          "existing_skill_notes"
        ],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 63},
          "title": {"type": "string", "minLength": 1, "maxLength": 128},
          "summary": {"type": "string", "minLength": 1, "maxLength": 1000},
          "source_block_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^block-[0-9a-f]{16}$"}
          },
          "triggers": {"$ref": "#/$defs/nonEmptyStrings"},
          "workflow_steps": {"$ref": "#/$defs/nonEmptyStrings"},
          "completion_criteria": {"$ref": "#/$defs/nonEmptyStrings"},
          "safety_boundaries": {"$ref": "#/$defs/nonEmptyStrings"},
          "resources": {
            "type": "array",
            "maxItems": 20,
            "uniqueItems": true,
            "items": {"enum": ["script", "reference", "asset", "none"]}
          },
          "scope": {"enum": ["cross-project", "project-family", "single-project"]},
          "stability": {"enum": ["stable", "evolving", "volatile"]},
          "automation": {"enum": ["deterministic", "mixed", "judgment"]},
          "disqualifiers": {
            "type": "array",
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "enum": ["existing-skill", "policy-only", "single-command", "project-specific", "sensitive", "volatile", "not-testable"]
            }
          },
          "existing_skill_notes": {
            "type": "array",
            "maxItems": 20,
            "items": {"type": "string", "minLength": 1, "maxLength": 1000}
          }
        }
      }
    }
  },
  "$defs": {
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {"type": "string", "minLength": 1, "maxLength": 1000}
    }
  }
}
