{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kolabse/skills/discover-skill-candidates/contribution-input.schema.json",
  "title": "Sanitized skill candidate contribution details",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence_summaries", "examples", "proposed_tests", "known_limitations", "attestations"],
  "properties": {
    "evidence_summaries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["block_id", "summary"],
        "properties": {
          "block_id": {"type": "string", "pattern": "^block-[0-9a-f]{16}$"},
          "summary": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    },
    "examples": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["prompt", "expected_outcomes"],
        "properties": {
          "prompt": {"type": "string", "minLength": 1, "maxLength": 1000},
          "expected_outcomes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {"type": "string", "minLength": 1, "maxLength": 1000}
          }
        }
      }
    },
    "proposed_tests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {"type": "string", "minLength": 1, "maxLength": 1000}
    },
    "known_limitations": {
      "type": "array",
      "maxItems": 20,
      "items": {"type": "string", "minLength": 1, "maxLength": 1000}
    },
    "attestations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["right_to_share", "apache_2_0", "no_secrets", "no_confidential_information"],
      "properties": {
        "right_to_share": {"const": true},
        "apache_2_0": {"const": true},
        "no_secrets": {"const": true},
        "no_confidential_information": {"const": true}
      }
    }
  }
}
