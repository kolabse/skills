{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kolabse/skills/discover-skill-candidates/report.schema.json",
  "title": "Ranked skill candidate discovery report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "read_only", "inventory_sha256", "catalog_skill_count", "counts", "candidates", "next_actions", "report_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "read_only": {"const": true},
    "inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "catalog_skill_count": {"type": "integer", "minimum": 0},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recommended", "investigate", "reject"],
      "properties": {
        "recommended": {"type": "integer", "minimum": 0},
        "investigate": {"type": "integer", "minimum": 0},
        "reject": {"type": "integer", "minimum": 0}
      }
    },
    "candidates": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["name", "score", "classification", "score_breakdown", "source_evidence", "review_flags", "rejection_reasons"],
        "properties": {
          "name": {"type": "string"},
          "score": {"type": "integer"},
          "classification": {"enum": ["recommended", "investigate", "reject"]},
          "score_breakdown": {"type": "object"},
          "source_evidence": {"type": "array"},
          "review_flags": {"type": "array", "items": {"type": "string"}},
          "rejection_reasons": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "next_actions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contribution_offer_required", "eligible_candidates", "automatic_external_submission", "options"],
      "properties": {
        "contribution_offer_required": {"type": "boolean"},
        "eligible_candidates": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
        },
        "automatic_external_submission": {"const": false},
        "options": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "recommended", "requires_user_confirmation"],
            "properties": {
              "id": {"enum": ["contribute-to-collection", "create-locally", "defer"]},
              "recommended": {"type": "boolean"},
              "requires_user_confirmation": {"type": "boolean"},
              "target_repository": {"type": "string"},
              "issue_url": {"type": "string"},
              "command": {"const": "export-contribution"},
              "skill": {"const": "skill-creator"}
            }
          }
        }
      }
    },
    "report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
