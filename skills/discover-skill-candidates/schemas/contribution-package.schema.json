{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kolabse/skills/discover-skill-candidates/contribution-package.schema.json",
  "title": "Portable skill candidate contribution package",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "license", "source_report", "candidate", "source_evidence", "examples", "proposed_tests", "known_limitations", "attestations", "package_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "skill-candidate-contribution"},
    "license": {"const": "Apache-2.0"},
    "source_report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inventory_sha256", "report_sha256"],
      "properties": {
        "inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "candidate": {
      "type": "object",
      "required": ["name", "title", "summary", "triggers", "workflow_steps", "completion_criteria", "safety_boundaries", "resources", "scope", "stability", "automation", "existing_skill_notes", "classification", "score", "score_breakdown", "existing_overlap", "review_flags"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "classification": {"enum": ["recommended", "investigate"]},
        "score": {"type": "integer"}
      }
    },
    "source_evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["block_id", "source_sha256", "summary"],
        "properties": {
          "block_id": {"type": "string", "pattern": "^block-[0-9a-f]{16}$"},
          "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "summary": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    },
    "examples": {"type": "array", "minItems": 1, "maxItems": 20},
    "proposed_tests": {"type": "array", "minItems": 1, "maxItems": 20},
    "known_limitations": {"type": "array", "maxItems": 20},
    "attestations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["right_to_share", "apache_2_0", "no_secrets", "no_confidential_information"],
      "properties": {
        "right_to_share": {"const": true},
        "apache_2_0": {"const": true},
        "no_secrets": {"const": true},
        "no_confidential_information": {"const": true}
      }
    },
    "package_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
