{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kolabse/skills/coordinate-code-documentation-repositories/plan.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "mode", "config_sha256", "outcome", "documentation_sources", "documentation_targets", "topics", "repositories", "blockers", "ready", "mutates_repositories", "plan_sha256"],
  "properties": {
    "schema_version": {"const": 1}, "mode": {"const": "plan"},
    "config_sha256": {"$ref": "#/$defs/sha256"}, "outcome": {"type": "string"},
    "documentation_sources": {"type": "array", "items": {"type": "string"}},
    "documentation_targets": {"type": "array", "items": {"type": "string"}},
    "topics": {"type": "array", "items": {"type": "string"}},
    "repositories": {"type": "object", "required": ["implementation", "documentation"], "additionalProperties": {"$ref": "#/$defs/repository"}},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "ready": {"type": "boolean"}, "mutates_repositories": {"const": false},
    "plan_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repository": {"type": "object", "additionalProperties": false, "required": ["path", "head", "upstream", "upstream_sha"], "properties": {"path": {"type": "string"}, "head": {"type": ["string", "null"]}, "upstream": {"type": ["string", "null"]}, "upstream_sha": {"type": ["string", "null"]}}}
  }
}
