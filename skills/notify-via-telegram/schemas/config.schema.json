{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kolabse/skills/notify-via-telegram/config.schema.json",
  "title": "Telegram notification configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "bot_token", "chat_id"],
  "properties": {
    "version": {"const": 1},
    "bot_token": {"type": "string", "minLength": 1},
    "chat_id": {"type": "string", "pattern": "^-?[0-9]+$"},
    "message_thread_id": {"type": "string", "pattern": "^[0-9]+$"}
  }
}
