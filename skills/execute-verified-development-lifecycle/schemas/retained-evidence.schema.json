{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kolabse/skills/execute-verified-development-lifecycle/retained-evidence.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_sha256", "config_sha256", "checkpoint", "observed_at", "subjects", "assertions", "producer", "artifact_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "plan_sha256": {"$ref": "#/$defs/sha"},
    "config_sha256": {"$ref": "#/$defs/sha"},
    "checkpoint": {"enum": ["task-claimed", "feature-prepared", "tdd-red", "tdd-green", "changed-scope-preflight", "review-complete", "push-verified", "feature-published", "feature-pipeline", "documentation-ready", "development-integrated", "documentation-published", "production-delegated", "deployment-observed", "marker-observed", "smoke-passed", "documentation-complete", "cleanup-proved"]},
    "observed_at": {"type": "string", "format": "date-time"},
    "subjects": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "assertions": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "producer": {"type": "string", "minLength": 1},
    "artifact_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {"sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
