{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kolabse/skills/execute-verified-development-lifecycle/plan.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "mode", "lifecycle_id", "outcome", "config_sha256", "feature_ref", "changed_scope", "repositories", "rules", "rule_installations", "references", "declared_files", "checks", "gates", "adapters", "required_capabilities", "documentation_targets", "notifications", "integration", "production", "delivery", "cleanup", "reminders", "blockers", "ready", "mutates_repository", "plan_sha256"],
  "properties": {
    "schema_version": {"const": 1}, "mode": {"const": "plan"}, "lifecycle_id": {"type": "string"}, "outcome": {"type": "string"}, "config_sha256": {"$ref": "#/$defs/sha"}, "feature_ref": {"type": "string"},
    "changed_scope": {"type": "array", "items": {"type": "string"}}, "repositories": {"type": "array", "items": {"type": "object"}}, "rules": {"type": "array", "items": {"type": "string"}}, "rule_installations": {"type": "array", "items": {"type": "object"}}, "references": {"type": "array", "items": {"type": "string"}}, "declared_files": {"type": "array", "items": {"type": "object"}}, "checks": {"type": "array", "items": {"type": "object"}}, "gates": {"type": "array", "items": {"type": "object"}}, "adapters": {"type": "array", "items": {"type": "object"}}, "required_capabilities": {"type": "array", "items": {"type": "string"}}, "feature_bootstrap": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["repository", "policy", "adapter", "mechanism", "fallback", "evidence_required"], "properties": {"repository": {"type": "string"}, "policy": {"const": "suppress-unchanged"}, "adapter": {"type": "string"}, "mechanism": {"enum": ["github-actions-unchanged-ref-guard", "gitlab-ci-skip-push-option"]}, "fallback": {"const": "run-pipeline"}, "evidence_required": {"const": true}}}}, "documentation_targets": {"type": "array", "items": {"type": "string"}}, "notifications": {"type": "array", "items": {"type": "string"}},
    "integration": {"type": "object"}, "production": {"type": "object"}, "delivery": {"type": "object"}, "cleanup": {"type": "object"}, "reminders": {"type": "array", "items": {"type": "string"}}, "blockers": {"type": "array", "items": {"type": "string"}}, "ready": {"type": "boolean"}, "mutates_repository": {"const": false}, "plan_sha256": {"$ref": "#/$defs/sha"}
  }, "$defs": {"sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
