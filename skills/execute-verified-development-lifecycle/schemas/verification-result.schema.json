{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kolabse/skills/execute-verified-development-lifecycle/verification-result.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "mode", "lifecycle_id", "plan_sha256", "current_checkpoint", "completed_checkpoints", "missing_checkpoints", "production_delegated", "blockers", "passed", "mutates_repository", "report_sha256"],
  "properties": {"schema_version": {"const": 1}, "mode": {"const": "verify"}, "lifecycle_id": {"type": "string"}, "plan_sha256": {"type": "string"}, "current_checkpoint": {"type": ["string", "null"]}, "completed_checkpoints": {"type": "array", "items": {"type": "string"}}, "missing_checkpoints": {"type": "array", "items": {"type": "string"}}, "production_delegated": {"type": "boolean"}, "blockers": {"type": "array", "items": {"type": "string"}}, "passed": {"type": "boolean"}, "mutates_repository": {"const": false}, "report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
