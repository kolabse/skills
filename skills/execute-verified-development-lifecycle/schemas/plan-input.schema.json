{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kolabse/skills/execute-verified-development-lifecycle/plan-input.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["lifecycle_id", "outcome", "feature_ref", "changed_scope", "repositories", "rules_read", "references_read", "documentation_targets", "notifications"],
  "properties": {
    "lifecycle_id": {"type": "string", "minLength": 1}, "outcome": {"type": "string", "minLength": 1}, "feature_ref": {"type": "string", "minLength": 1},
    "changed_scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "repositories": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["name", "start_commit", "upstream_commit", "clean", "current"], "properties": {"name": {"type": "string"}, "start_commit": {"$ref": "#/$defs/commit"}, "upstream_commit": {"$ref": "#/$defs/commit"}, "clean": {"const": true}, "current": {"const": true}}}},
    "rules_read": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "references_read": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "documentation_targets": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "notifications": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
  },
  "$defs": {"commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"}}
}
