{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kolabse/skills/execute-configured-gitflow-releases/route-input.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["release_id", "source_branch", "explicit_hotfix"],
  "properties": {
    "release_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "route": {"enum": ["standard", "hotfix"]},
    "source_branch": {"type": "string", "minLength": 1},
    "explicit_hotfix": {"type": "boolean"}
  }
}
