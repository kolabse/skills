{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kolabse/skills/execute-configured-gitflow-releases/plan.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "mode", "release_id", "route", "config_sha256", "remote", "source_branch", "target_branch", "source_commit", "remote_identities", "gates", "deployment_evidence_required", "reintegration_required", "warnings", "blockers", "ready", "mutates_repository", "plan_sha256"],
  "properties": {
    "schema_version": {"const": 1}, "mode": {"const": "plan"}, "release_id": {"type": "string"},
    "route": {"enum": ["standard", "hotfix"]}, "config_sha256": {"$ref": "#/$defs/sha256"},
    "remote": {"type": "string"}, "source_branch": {"type": "string"}, "target_branch": {"type": "string"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "remote_identities": {"type": "object", "additionalProperties": false, "required": ["development", "production"], "properties": {"development": {"type": ["string", "null"]}, "production": {"type": ["string", "null"]}}},
    "gates": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "deployment_evidence_required": {"type": "boolean"}, "reintegration_required": {"type": "boolean"},
    "warnings": {"type": "array", "items": {"type": "string"}}, "blockers": {"type": "array", "items": {"type": "string"}},
    "ready": {"type": "boolean"}, "mutates_repository": {"const": false}, "plan_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
