{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kolabse/skills/release-skill-collection/state.schema.json",
  "title": "Release collection status or plan",
  "type": "object",
  "required": ["schema_version", "mode", "project_root", "repository", "blockers", "warnings", "ready_for_local_checks", "mutates_repository", "report_sha256"],
  "properties": {
    "schema_version": {"const": 2},
    "mode": {"enum": ["status", "plan"]},
    "project_root": {"type": "string"},
    "tag": {"type": ["string", "null"]},
    "repository": {"type": "object"},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "ready_for_local_checks": {"type": "boolean"},
    "mutates_repository": {"const": false},
    "report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": true
}
