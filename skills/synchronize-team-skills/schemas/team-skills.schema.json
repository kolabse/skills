{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kolabse/skills/blob/main/skills/synchronize-team-skills/schemas/team-skills.schema.json",
  "title": "Team agent skills manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "collection_version",
    "scope",
    "agents",
    "skills",
    "extras_policy"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "source": { "const": "kolabse/skills" },
    "collection_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?$"
    },
    "scope": { "const": "global" },
    "agents": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["claude-code", "codex"] }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "allOf": [
        { "contains": { "const": "synchronize-team-skills" } },
        { "contains": { "const": "synchronize-git-repositories" } }
      ],
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "extras_policy": { "const": "preserve" }
  }
}
