{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Observed calendar state for read-only preview",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "calendar_id", "observation_complete", "unknown_outcome_task_ids", "events", "links"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "calendar_id": {"$ref": "#/$defs/text"},
    "observation_complete": {"type": "boolean"},
    "unknown_outcome_task_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "events": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["event_id", "project_id", "task_id", "managed"],
      "properties": {"event_id": {"$ref": "#/$defs/text"}, "project_id": {"$ref": "#/$defs/text"}, "task_id": {"$ref": "#/$defs/text"}, "managed": {"$ref": "#/$defs/managed"}}
    }},
    "links": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["event_id", "project_id", "task_id", "last_synced"],
      "properties": {"event_id": {"$ref": "#/$defs/text"}, "project_id": {"$ref": "#/$defs/text"}, "task_id": {"$ref": "#/$defs/text"}, "last_synced": {"$ref": "#/$defs/managed"}}
    }}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "^[^\\s\\x00-\\x1f](?:[^\\x00-\\x1f]*[^\\s\\x00-\\x1f])?$"},
    "managed": {
      "oneOf": [{"$ref": "#/$defs/timed"}, {"$ref": "#/$defs/all_day"}]
    },
    "all_day": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "date"],
      "properties": {
        "title": {"$ref": "#/$defs/text"},
        "date": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
      }
    },
    "timed": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "starts_at", "duration_minutes"],
      "properties": {
        "title": {"$ref": "#/$defs/text"},
        "starts_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{2}:[0-9]{2}$"},
        "duration_minutes": {"type": "integer", "minimum": 1}
      }
    }
  }
}
