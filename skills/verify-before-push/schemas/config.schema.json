{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kolabse/skills/verify-before-push/config.schema.json",
  "title": "Verify Before Push configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "repositories", "checks"],
  "properties": {
    "version": {"const": 1},
    "reuse_verified_results": {"type": "boolean", "default": false},
    "evidence_file": {"type": "string", "minLength": 1},
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "require_clean": {"type": "boolean"},
          "require_upstream_current": {"type": "boolean"}
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "command"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "cwd": {"type": "string", "minLength": 1},
          "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
          "enabled": {"type": "boolean"},
          "required": {"type": "boolean"},
          "skip_reason": {"type": "string"}
        }
      }
    }
  }
}
