{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "development-source-review",
  "description": "Caller-supplied diagnostic assertions only. Hash binding proves neither chronology nor execution, identity or Git provenance. Never authorizes an action.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "repository": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "operation": {
      "type": "string",
      "enum": [
        "push",
        "merge",
        "build",
        "deploy",
        "cleanup"
      ]
    },
    "profile": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      ]
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_snapshot_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "format": {
      "type": "string",
      "const": "development_source_review"
    },
    "decision_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "subject": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "commit",
            "worktree"
          ]
        },
        "identity": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "identity"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "commit"
            },
            "identity": {
              "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$"
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "worktree"
            },
            "identity": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        }
      ]
    },
    "outcome": {
      "type": "string",
      "const": "approved"
    },
    "reviewer": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "review_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "repository",
    "operation",
    "profile",
    "policy_digest",
    "source_snapshot_digest",
    "format",
    "decision_digest",
    "subject",
    "outcome",
    "reviewer",
    "summary",
    "review_digest"
  ],
  "additionalProperties": false
}
