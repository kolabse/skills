{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "development-test-first-binding",
  "description": "Policy-bound wrapper for unchanged local v1 test-first evidence. The injected canonical v1 validator is required; this schema does not validate nested evidence semantics. Digests bind caller-supplied content, never chronology, execution, provenance or authorization.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "repository": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "operation": {
      "type": "string",
      "enum": [
        "push",
        "merge",
        "build",
        "deploy",
        "cleanup"
      ]
    },
    "profile": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      ]
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_snapshot_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "format": {
      "type": "string",
      "const": "development_test_first_binding"
    },
    "decision_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "subject": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "commit",
            "worktree"
          ]
        },
        "identity": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "identity"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "commit"
            },
            "identity": {
              "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$"
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "worktree"
            },
            "identity": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        }
      ]
    },
    "test_first_evidence": {
      "type": "object",
      "description": "Original immutable v1 evidence with its existing subject and evidence_digest. Acceptance requires the injected canonical v1 validator and agreement of wrapper, nested and expected subjects."
    },
    "binding_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema_version",
    "repository",
    "operation",
    "profile",
    "policy_digest",
    "source_snapshot_digest",
    "format",
    "decision_digest",
    "subject",
    "test_first_evidence",
    "binding_digest"
  ],
  "additionalProperties": false
}
