{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kolabse/skills/verify-before-push/evidence.schema.json",
  "title": "Git-state-bound verification evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "config_sha256", "checked_at", "repositories", "checks"],
  "properties": {
    "version": {"enum": [1, 2, 3]},
    "source": {"const": "github-ci"},
    "github_ci": {"$ref": "#/$defs/github_ci"},
    "config_sha256": {"$ref": "#/$defs/sha256"},
    "checked_at": {"type": "string", "format": "date-time"},
    "repositories": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/repository"}},
    "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}},
    "reuse_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_sha256", "environment_sha256", "tracking"],
      "properties": {
        "runtime_sha256": {"$ref": "#/$defs/sha256"},
        "environment_sha256": {"$ref": "#/$defs/sha256"},
        "tracking": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/tracking"}}
      }
    },
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [{
    "if": {"properties": {"version": {"const": 1}}},
    "then": {"not": {"anyOf": [{"required": ["reuse_identity"]}, {"required": ["receipt_sha256"]}, {"required": ["source"]}, {"required": ["github_ci"]}]}},
    "else": {
      "if": {"properties": {"version": {"const": 2}}},
      "then": {"required": ["reuse_identity", "receipt_sha256"], "not": {"anyOf": [{"required": ["source"]}, {"required": ["github_ci"]}]}},
      "else": {"required": ["source", "github_ci", "receipt_sha256"], "not": {"required": ["reuse_identity"]}}
    }
  }, {
    "if": {"properties": {"version": {"const": 3}}},
    "then": {
      "properties": {
        "repositories": {"maxItems": 1, "items": {"properties": {"clean": {"const": true}}}},
        "checks": {"items": {"not": {"required": ["exit_code"]}}}
      }
    },
    "else": {"properties": {"checks": {"items": {"not": {"required": ["source"]}}}}}
  }],
  "$defs": {
    "github_ci": {
      "type": "object", "additionalProperties": false,
      "required": ["git_identity", "workflows"],
      "properties": {
        "git_identity": {"$ref": "#/$defs/tracking"},
        "workflows": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["workflow", "run_id", "run_number", "run_attempt", "head_sha", "head_branch", "event", "repository", "status", "conclusion", "jobs"],
            "properties": {
              "workflow": {"type": "string", "pattern": "^\\.github/workflows/[A-Za-z0-9_.-]+\\.ya?ml$"},
              "run_id": {"type": "integer", "minimum": 1},
              "run_number": {"type": "integer", "minimum": 1},
              "run_attempt": {"type": "integer", "minimum": 1},
              "head_sha": {"$ref": "#/$defs/oid"},
              "head_branch": {"type": "string", "minLength": 1},
              "event": {"const": "push"},
              "repository": {"type": "string", "pattern": "^[A-Za-z0-9_-]+/[A-Za-z0-9_-][A-Za-z0-9_.-]*$"},
              "status": {"const": "completed"}, "conclusion": {"const": "success"},
              "jobs": {
                "type": "array", "minItems": 1,
                "items": {
                  "type": "object", "additionalProperties": false,
                  "required": ["name", "id", "status", "conclusion"],
                  "properties": {
                    "name": {"type": "string", "minLength": 1},
                    "id": {"type": "integer", "minimum": 1},
                    "status": {"const": "completed"}, "conclusion": {"const": "success"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "oid": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "head", "worktree_sha256", "clean", "upstream", "upstream_sha", "ahead", "behind"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "head": {"$ref": "#/$defs/oid"},
        "worktree_sha256": {"$ref": "#/$defs/sha256"},
        "clean": {"type": "boolean"},
        "upstream": {"type": "string"},
        "upstream_sha": {"anyOf": [{"const": ""}, {"$ref": "#/$defs/oid"}]},
        "ahead": {"type": ["integer", "null"], "minimum": 0},
        "behind": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "tracking": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "git_dir", "branch", "remote", "merge", "remote_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "git_dir": {"type": "string", "minLength": 1},
        "branch": {"type": "string", "pattern": "^refs/heads/.+"},
        "remote": {"type": "string", "minLength": 1},
        "merge": {"type": "string", "pattern": "^refs/heads/.+"},
        "remote_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "check": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["name", "status", "source"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "status": {"const": "passed"}, "source": {"const": "github-ci"}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["name", "status", "exit_code"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "status": {"enum": ["passed", "failed"]},
            "exit_code": {"type": "integer"}
          },
          "allOf": [{
            "if": {"properties": {"status": {"const": "passed"}}},
            "then": {"properties": {"exit_code": {"const": 0}}},
            "else": {"properties": {"exit_code": {"not": {"const": 0}}}}
          }]
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["name", "status", "reason"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "status": {"const": "skipped"},
            "reason": {"type": "string", "minLength": 1}
          }
        }
      ]
    }
  }
}
