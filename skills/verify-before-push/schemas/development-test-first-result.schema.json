{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "development-test-first-result",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "blocked",
        "verified"
      ]
    },
    "mode": {
      "enum": [
        "test_first",
        "final_verification",
        null
      ]
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "readiness_kind": {
      "type": "string",
      "const": "diagnostic_consistency_only"
    },
    "provider_confirmation": {
      "type": "string",
      "const": "unconfirmed"
    },
    "authorization": {
      "type": "string",
      "const": "not_granted"
    },
    "observations": {
      "type": "string",
      "const": "caller_supplied"
    },
    "chronology": {
      "type": "string",
      "const": "not_attested"
    },
    "subject_provenance": {
      "type": "string",
      "const": "caller_supplied_not_reconstructed"
    },
    "bindings": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "operation": {
              "type": "string",
              "enum": [
                "push",
                "merge",
                "build",
                "deploy",
                "cleanup"
              ]
            },
            "profile": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              ]
            },
            "policy_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "source_snapshot_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "subject": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "commit",
                    "worktree"
                  ]
                },
                "identity": {
                  "type": "string"
                }
              },
              "required": [
                "kind",
                "identity"
              ],
              "additionalProperties": false,
              "oneOf": [
                {
                  "properties": {
                    "kind": {
                      "const": "commit"
                    },
                    "identity": {
                      "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$"
                    }
                  }
                },
                {
                  "properties": {
                    "kind": {
                      "const": "worktree"
                    },
                    "identity": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    }
                  }
                }
              ]
            },
            "decision_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "evidence_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "binding_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "repository",
            "operation",
            "profile",
            "policy_digest",
            "source_snapshot_digest",
            "subject",
            "decision_digest",
            "evidence_digest",
            "binding_digest"
          ],
          "additionalProperties": false
        }
      ]
    },
    "check_scope": {
      "type": "string",
      "const": "focused_and_broader_contract_only"
    },
    "report_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "test_first_satisfied": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "status",
    "mode",
    "diagnostics",
    "readiness_kind",
    "provider_confirmation",
    "authorization",
    "observations",
    "chronology",
    "subject_provenance",
    "bindings",
    "test_first_satisfied",
    "check_scope",
    "report_digest"
  ],
  "additionalProperties": false,
  "description": "Sealed consistency diagnostic for a policy-bound local v1 test-first record. Observations are caller supplied; chronology, execution and provider confirmation are not attested and no action is authorized."
}
