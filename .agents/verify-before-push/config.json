{
  "version": 1,
  "evidence_file": ".agents/verify-before-push/evidence.json",
  "repositories": [
    {
      "name": "skill-collection",
      "path": ".",
      "require_clean": true,
      "require_upstream_current": true
    }
  ],
  "checks": [
    {
      "name": "collection-full",
      "cwd": ".",
      "command": ["python", "scripts/check_collection.py", "run", "--profile", "full"],
      "timeout_seconds": 1800,
      "required": true
    },
    {
      "name": "consumer-smoke",
      "cwd": ".",
      "command": ["python", "scripts/check_collection.py", "run", "--profile", "consumers"],
      "timeout_seconds": 1500,
      "required": true
    }
  ]
}
