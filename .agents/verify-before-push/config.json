{
  "version": 1,
  "github_ci": {
    "repository": "kolabse/skills",
    "remote": "origin",
    "branch": "main",
    "event": "push",
    "checks": {
      "telegram-bridge-prototype": {
        "workflow": ".github/workflows/telegram-bridge.yml",
        "jobs": ["windows-prototype (3.11)", "windows-prototype (3.13)"]
      },
      "collection-full": {
        "workflow": ".github/workflows/validate.yml",
        "jobs": [
          "validate (ubuntu-latest, 3.11)", "validate (ubuntu-latest, 3.13)",
          "validate (windows-latest, 3.11)", "validate (windows-latest, 3.13)",
          "validate (macos-latest, 3.11)", "validate (macos-latest, 3.13)"
        ]
      },
      "consumer-smoke": {
        "workflow": ".github/workflows/validate.yml",
        "jobs": ["skills-cli-discovery"]
      }
    }
  },
  "evidence_file": ".agents/verify-before-push/evidence.json",
  "repositories": [
    {
      "name": "skill-collection",
      "path": ".",
      "require_clean": true,
      "require_upstream_current": true
    }
  ],
  "checks": [
    {
      "name": "telegram-bridge-prototype",
      "cwd": ".",
      "command": ["python", "prototypes/telegram_task_bridge/run_checks.py"],
      "timeout_seconds": 600,
      "required": true
    },
    {
      "name": "collection-full",
      "cwd": ".",
      "command": ["python", "scripts/check_collection.py", "run", "--profile", "full"],
      "timeout_seconds": 1800,
      "required": true
    },
    {
      "name": "consumer-smoke",
      "cwd": ".",
      "command": ["python", "scripts/check_collection.py", "run", "--profile", "consumers"],
      "timeout_seconds": 1500,
      "required": true
    }
  ]
}
