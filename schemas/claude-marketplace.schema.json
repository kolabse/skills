{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "kolabse Claude Code marketplace",
  "type": "object",
  "required": ["name", "owner", "plugins"],
  "properties": {
    "name": {"const": "kolabse"},
    "owner": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "email": {"type": "string"},
        "url": {"type": "string", "format": "uri"}
      },
      "additionalProperties": true
    },
    "plugins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "source"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "source": {
            "oneOf": [
              {"type": "string", "minLength": 1},
              {"type": "object"}
            ]
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
