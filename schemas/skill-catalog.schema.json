{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kolabse/skills/blob/main/schemas/skill-catalog.schema.json",
  "title": "kolabse skill catalog",
  "type": "object",
  "required": [
    "schema_version",
    "catalog_schema",
    "collection_version",
    "supported_agents",
    "license",
    "category_order",
    "skills"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "catalog_schema": { "const": "schemas/skill-catalog.schema.json" },
    "collection_version": { "type": "string" },
    "supported_agents": {
      "const": ["claude-code", "codex"]
    },
    "license": { "type": "string", "minLength": 1 },
    "category_order": {
      "type": "array",
      "prefixItems": [
        { "const": "development-quality" },
        { "const": "repository-delivery" },
        { "const": "project-knowledge" },
        { "const": "collaboration" },
        { "const": "infrastructure-operations" },
        { "const": "collection-maintenance" }
      ],
      "items": false,
      "minItems": 6,
      "maxItems": 6
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "path",
          "category",
          "tags",
          "status",
          "maintainers",
          "platforms",
          "license"
        ],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "path": { "type": "string", "pattern": "^skills/[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "category": { "$ref": "#/$defs/category" },
          "tags": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/tag" }
          },
          "status": { "enum": ["experimental", "stable", "deprecated"] },
          "maintainers": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "platforms": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["linux", "macos", "windows"] }
          },
          "license": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "category": {
      "enum": [
        "development-quality",
        "repository-delivery",
        "project-knowledge",
        "collaboration",
        "infrastructure-operations",
        "collection-maintenance"
      ]
    },
    "tag": {
      "enum": [
        "prepare",
        "investigate",
        "implement",
        "verify",
        "publish",
        "operate",
        "document",
        "handoff",
        "project",
        "repository",
        "multi-repository",
        "workstation",
        "external-service",
        "skill-collection",
        "read-only-planning",
        "mutation",
        "evidence-producing",
        "orchestration",
        "notification",
        "git",
        "github",
        "telegram",
        "google-drive",
        "yandex-cloud"
      ]
    }
  }
}
