{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shared collection check program",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "checks",
    "profiles"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "checks": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "timeout_seconds"
        ],
        "properties": {
          "command": {
            "type": "array",
            "minItems": 1,
            "prefixItems": [
              {
                "enum": [
                  "{python}",
                  "{npx}"
                ]
              }
            ],
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1800
          }
        }
      }
    },
    "profiles": {
      "type": "object",
      "required": [
        "preflight",
        "full"
      ],
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
