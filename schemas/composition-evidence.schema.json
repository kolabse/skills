{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kolabse/skills/composition-evidence.schema.json",
  "title": "Skill composition execution evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "composition", "plan_sha256", "steps", "evidence_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "composition": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["skill", "status", "evidence_sha256"],
        "properties": {
          "skill": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "status": {"enum": ["passed", "failed", "skipped"]},
          "evidence_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
