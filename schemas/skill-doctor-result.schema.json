{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kolabse/skills/schemas/skill-doctor-result.schema.json",
  "title": "Opt-in source_diagnostics extension of the existing doctor result",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "agent", "mutates", "scope", "sources", "copies", "conflicts", "observations", "limitations"],
  "properties": {
    "schema_version": {"const": 1},
    "agent": {"enum": ["codex", "claude-code"]},
    "mutates": {"const": false},
    "scope": {"const": "bounded-explicit-sources"},
    "sources": {
      "type": "array", "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["kind", "path", "status", "reason_code"],
        "properties": {
          "kind": {"enum": ["project", "user-root", "plugin"]},
          "path": {"type": "string"},
          "status": {"enum": ["inspected", "missing", "unsafe", "invalid"]},
          "reason_code": {"type": ["string", "null"]}
        }
      }
    },
    "copies": {
      "type": "array", "maxItems": 512,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["skill", "path", "source_path", "source_kind", "installed", "version", "metadata_status", "source_identity", "skill_sha256", "issues"],
        "properties": {
          "skill": {"$ref": "#/$defs/skill"},
          "path": {"type": "string"},
          "source_path": {"type": "string"},
          "source_kind": {"enum": ["project", "user-root", "plugin"]},
          "installed": {"type": "boolean", "description": "A bounded regular SKILL.md was readable. Does not prove agent availability or valid skill semantics."},
          "version": {"type": ["string", "null"]},
          "metadata_status": {"enum": ["consistent", "missing", "invalid"]},
          "source_identity": {"type": ["string", "null"]},
          "skill_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "issues": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "conflicts": {
      "type": "array", "maxItems": 512,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["skill", "kinds", "paths", "versions", "effective_copy"],
        "properties": {
          "skill": {"$ref": "#/$defs/skill"},
          "kinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["duplicate-copies", "version-conflict", "content-conflict", "source-conflict"]}},
          "paths": {"type": "array", "minItems": 2, "items": {"type": "string"}},
          "versions": {"type": "array", "minItems": 2, "items": {"type": ["string", "null"]}},
          "effective_copy": {"const": "unknown"}
        }
      }
    },
    "observations": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "context_id", "observed_at", "skills"],
      "properties": {
        "status": {"enum": ["not-provided", "user-reported"]},
        "context_id": {"type": ["string", "null"]},
        "observed_at": {"type": ["string", "null"]},
        "skills": {"type": "array", "maxItems": 1024, "items": {"$ref": "#/$defs/observation"}}
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "skill": {"type": "string", "maxLength": 63, "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": ["skill", "availability", "invocation", "copy_path"],
      "properties": {
        "skill": {"$ref": "#/$defs/skill"},
        "availability": {"enum": ["available", "unavailable", "unknown"]},
        "invocation": {"enum": ["invoked", "not-invoked", "unknown"]},
        "copy_path": {"type": ["string", "null"]}
      }
    }
  }
}
